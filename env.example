# Copy to .env and fill in. Never commit the real .env.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True

DB_NAME=campuslife
DB_USER=campuslife
DB_PASSWORD=campuslife

# --- Optional / third-party integrations ---
# Leave these blank for local/offline use. If your code calls these services
# unconditionally (Cloudinary uploads, Paystack charges, email sends), those
# specific endpoints will error without real values — but the app itself,
# login, and browsing should still work.
FRONTEND_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUD_API_SECRET=
EMAIL_HOST_PASSWORD=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
